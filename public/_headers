# Les URL techniques de Cloudflare Pages (*.pages.dev) ne doivent pas être
# indexées : elles dupliquent gabrielnadon.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Polices auto-hébergées : noms de fichiers stables, contenu immuable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
